---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Engraving from '../components/Engraving.astro';
import SectionHead from '../components/SectionHead.astro';
import Dispatch from '../components/Dispatch.astro';
import Highlights from '../components/Highlights.astro';
import Trail from '../components/Trail.astro';
import Mine from '../components/Mine.astro';
import Awards from '../components/Awards.astro';
import Register from '../components/Register.astro';
import Faq from '../components/Faq.astro';
import TornEdge from '../components/TornEdge.astro';
import faq from '../data/faq.json';
import { SITE } from '../config/site';
import { withBase } from '../lib/paths';
import sluice from '../assets/engravings/sandham-the-sluice-1883.jpg';
import harbor from '../assets/engravings/san-francisco-harbor-1849.jpg';

const homeFaq = faq.filter((f) => f.home);
---

<Base>
  <Hero />

  <section class="paper section" id="about">
    <Engraving src={sluice} variant="ink" shape="bleed" width={900} quality={45} style="--x:-140px;--b:0;--w:680px;--ar:5/4;--opacity:.11;--pos:center 60%" />
    <div class="container">
      <Dispatch />
      <Highlights />
    </div>
  </section>

  <section class="paper section" id="timeline">
    <div class="container container--wide">
      <SectionHead eyebrow="Six weeks · Oct 13 → Nov 22" title="The Claim Trail" lead="Online for everyone from Oct 13 until the Assay, the Nov 22 deadline. The Tuesday workshops are for SMC students." />
      <Trail />
    </div>
  </section>

  <section class="mine" id="how">
    <div class="rule-double"></div>
    <div class="container section">
      <SectionHead center eyebrow="How it works" title="From greenhorn to prospector, four levels down" />
      <Mine />
    </div>
    <TornEdge to="paper" />
  </section>

  <section class="paper section" id="awards">
    <div class="container">
      <SectionHead eyebrow="Awards" title="The Claims" lead="One leaderboard, several ways to win. Full details are on the Rules page." />
      <Awards />
    </div>
  </section>

  <section class="board section" id="register">
    <div class="container">
      <SectionHead center eyebrow="Registration" title="Stake Your Claim" lead="Free, two minutes, open to California community college students 18+. Registration closes Sunday, Nov 15." />
      <Register />
    </div>
  </section>

  <section class="paper section" id="faq">
    <Engraving src={harbor} variant="ink" shape="bleed" width={700} quality={45} style="--r:-120px;--y:20px;--w:520px;--ar:3/4;--opacity:.1;--pos:center 30%" />
    <div class="container container--narrow">
      <SectionHead eyebrow="Prospector's handbook" title="Questions from the camp" />
      <Faq items={homeFaq} openFirst ledger />
      <p style="margin-top:24px"><a class="link" href={withBase('/rules/')}>Read the full rules &amp; FAQ →</a></p>
    </div>
    <TornEdge to="dark" />
  </section>
</Base>
