---
import { SITE } from '../config/site';

interface Item {
  q: string;
  a: string;
  tbd?: boolean;
  home?: boolean;
  /** 'discord' appends a link to the Discord invite. */
  cta?: string;
}
interface Props {
  items: Item[];
  openFirst?: boolean;
  /** Render on a ruled ledger page with numbered questions in the margin. */
  ledger?: boolean;
  page?: string;
}
const { items, openFirst = false, ledger = false, page = 'p. 12' } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class={ledger ? 'ledger reveal' : 'reveal'}>
  {ledger && (
    <div class="ledger__head" aria-hidden="true">
      <span>Prospector's ledger<span class="ledger__opt"> · Q &amp; A</span></span>
      <span>{page}</span>
    </div>
  )}
  <div class="faq">
    {items.map((item, i) => (
      <details open={openFirst && i === 0}>
        <summary>
          {ledger && <span class="faq__num" aria-hidden="true">Q.{pad(i + 1)}</span>}
          {item.q}
        </summary>
        <div class="faq__body">
          {item.a}
          {item.tbd && <span class="badge badge--tbd" style="--tilt:-2deg;margin-left:6px">To be finalized</span>}
          {item.cta === 'discord' && SITE.links.discord && (
            <> <a class="link" href={SITE.links.discord} target="_blank" rel="noopener">Join the Discord →</a></>
          )}
        </div>
      </details>
    ))}
  </div>
</div>

<script>
  // Animate <details> open and close: the height eases between the summary and the full
  // answer while the answer fades. Native toggling is kept under reduced motion.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((details) => {
    const summary = details.querySelector('summary');
    const body = details.querySelector<HTMLElement>('.faq__body');
    if (!summary || !body) return;

    let anim: Animation | null = null;
    let closing = false;
    let runId = 0;
    const borders = () => details.offsetHeight - details.clientHeight;

    const finish = (open: boolean) => {
      runId++;
      anim?.cancel();
      anim = null;
      closing = false;
      details.open = open;
      details.classList.remove('is-closing');
      details.style.height = '';
      details.style.overflow = '';
    };

    const run = (from: number, to: number, open: boolean, duration: number) => {
      anim?.cancel();
      const id = ++runId;
      const end = () => {
        if (id === runId) finish(open);
      };
      anim = details.animate({ height: [`${from}px`, `${to}px`] }, { duration, easing: 'cubic-bezier(.2, .8, .2, 1)' });
      anim.onfinish = end;
      // Fallback for when no frame renders the finish event (a throttled or hidden page).
      window.setTimeout(end, duration + 80);
    };

    const expand = () => {
      const from = details.offsetHeight;
      details.classList.remove('is-closing');
      details.style.overflow = 'hidden';
      details.style.height = `${from}px`;
      details.open = true;
      closing = false;
      // Reading offsetHeight forces layout, so the answer can be measured right after opening.
      run(from, summary.offsetHeight + body.offsetHeight + borders(), true, 300);
    };

    const collapse = () => {
      closing = true;
      details.classList.add('is-closing');
      details.style.overflow = 'hidden';
      run(details.offsetHeight, summary.offsetHeight + borders(), false, 240);
    };

    summary.addEventListener('click', (e) => {
      if (reduced.matches) return;
      e.preventDefault();
      if (!details.open || closing) expand();
      else collapse();
    });
  });
</script>
