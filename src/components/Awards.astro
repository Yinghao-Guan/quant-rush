---
/** Awards as rosette medals on a wooden display shelf. */
import Icon from './Icon.astro';
import awards from '../data/awards.json';

const tones: Record<string, { c1: string; c2: string }> = {
  gold: { c1: 'var(--gold-500)', c2: 'var(--gold-300)' },
  green: { c1: 'var(--green-700)', c2: 'var(--green-400)' },
  rust: { c1: 'var(--rust-500)', c2: 'var(--rust-300)' },
  tarnish: { c1: '#8C7A62', c2: '#B8A77F' },
};

// A 16-scallop rosette outline on a 100×100 box.
const scallops = 16;
const R = 44;
const r = 9;
const pts = Array.from({ length: scallops }, (_, i) => {
  const a = (i / scallops) * Math.PI * 2 - Math.PI / 2;
  return [50 + R * Math.cos(a), 50 + R * Math.sin(a)];
});
const rosette =
  pts
    .map((p, i) => {
      const n = pts[(i + 1) % scallops];
      const start = i === 0 ? `M ${p[0].toFixed(2)} ${p[1].toFixed(2)} ` : '';
      return `${start}A ${r} ${r} 0 0 1 ${n[0].toFixed(2)} ${n[1].toFixed(2)}`;
    })
    .join(' ') + ' Z';
---

<ul class="shelf reveal">
  {awards.map((a, i) => {
    const t = tones[a.tone] ?? tones.gold;
    return (
      <li class={`medal ${a.joke ? 'medal--joke' : ''}`} style={`--c1:${t.c1};--c2:${t.c2};--n:${i + 1}`}>
        <div class="medal__hang">
          <i class="medal__tail medal__tail--l" aria-hidden="true"></i>
          <i class="medal__tail medal__tail--r" aria-hidden="true"></i>
          <svg class="medal__rosette" viewBox="0 0 100 100" aria-hidden="true">
            <path d={rosette} fill="var(--c1)" stroke="var(--ink-800)" stroke-width="1.5"></path>
            <circle cx="50" cy="50" r="34" fill="var(--c2)" stroke="var(--ink-800)" stroke-width="1.2"></circle>
            <circle cx="50" cy="50" r="27" fill="var(--paper-50)" stroke="var(--ink-800)" stroke-width="1.2"></circle>
          </svg>
          <span class="medal__icon"><Icon name={a.icon} /></span>
          {a.joke && <span class="badge badge--joke medal__joke">Joke award</span>}
        </div>
        <div class="medal__plate">
          <span class="medal__category">{a.category}</span>
          <h3 class="medal__name">{a.name}</h3>
          {a.medals && <span class="medals" aria-hidden="true"><i></i><i></i><i></i></span>}
        </div>
        <p class="medal__blurb">{a.blurb}</p>
      </li>
    );
  })}
</ul>
<div class="notice reveal" style="margin-top:40px">
  <span class="notice__label">On the record</span>
  Prizes are real. We'll announce what they are here and on Discord.
</div>
