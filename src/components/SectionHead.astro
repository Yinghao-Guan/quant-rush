---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  center?: boolean;
  class?: string;
}
const { eyebrow, title, lead, center = false, class: className = '' } = Astro.props;
---

<header class={`section-head ${center ? 'section-head--center' : ''} reveal ${className}`.trim()}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</header>
