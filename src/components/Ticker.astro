---
import items from '../data/ticker.json';
import { SITE } from '../config/site';

const days = Math.max(0, Math.ceil((new Date(SITE.dates.deadline).getTime() - Date.now()) / 864e5));
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {[0, 1].map(() => (
      <span class="ticker__group">
        {SITE.tickerPin && (
          <span class="ticker__item"><span class="ticker__pin">{SITE.tickerPin}</span></span>
        )}
        {items.map(([sym, dir, val]) => (
          <span class="ticker__item">
            <span>{sym}</span>
            <span class={dir === '▲' ? 'ticker__up' : 'ticker__down'}>{dir} {val}</span>
          </span>
        ))}
        <span class="ticker__item"><span data-ticker-days data-deadline={SITE.dates.deadline}>T-{days} DAYS TO THE ASSAY</span></span>
      </span>
    ))}
  </div>
</div>
<p class="sr-only">Quant Rush opens October 13 and submissions close November 22, 2026.</p>

<script>
  // Keep the countdown item honest with the visitor's clock.
  document.querySelectorAll<HTMLElement>('[data-ticker-days]').forEach((el) => {
    const deadline = new Date(el.dataset.deadline ?? '').getTime();
    if (Number.isNaN(deadline)) return;
    const days = Math.max(0, Math.ceil((deadline - Date.now()) / 864e5));
    el.textContent = days > 0 ? `T-${days} DAYS TO THE ASSAY` : 'THE ASSAY IS IN';
  });
</script>
