---
/**
 * Decorative candlestick row. Heights come from a seeded generator so the
 * build output is stable. CSS hides the extra candles on small screens.
 */
interface Props {
  count?: number;
  seed?: number;
  class?: string;
}
const { count = 36, seed = 1849, class: className = '' } = Astro.props;

let s = seed >>> 0;
const rnd = () => ((s = (Math.imul(s, 1664525) + 1013904223) >>> 0) / 4294967296);
const candles = Array.from({ length: count }, (_, i) => {
  const up = rnd() > 0.32;
  const body = 16 + Math.round(rnd() * 50);
  const base = Math.round(rnd() * 28);
  const wick = Math.min(100, body + base + 8 + Math.round(rnd() * 16));
  const kind = i === count - 1 ? 'gold' : up ? 'up' : 'down';
  return { i, body, base, wick, kind };
});
---

<div class={`candles ${className}`.trim()} aria-hidden="true">
  {candles.map((c) => (
    <span class={`candle candle--${c.kind}`} style={`--i:${c.i};--body:${c.body}%;--base:${c.base}%;--wick:${c.wick}%`}>
      <span class="candle__wick"></span>
      <span class="candle__body"></span>
    </span>
  ))}
</div>
