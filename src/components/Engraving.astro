---
/**
 * A duotoned public-domain engraving. Every image passed here must be listed in CREDITS.md.
 * variant: ink (multiply on paper) | gold (inverted, screened on dark)
 * shape:   backdrop (absolute, gradient-masked) | medallion (circle) | plain
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  variant?: 'ink' | 'gold';
  shape?: 'backdrop' | 'medallion' | 'plain';
  /** object-position for the crop, e.g. "center 40%" */
  pos?: string;
  /** backdrop opacity */
  opacity?: number;
  /** medallion diameter in px */
  size?: number;
  /** rendered image width in px (webp) */
  width?: number;
  quality?: number;
  eager?: boolean;
  credit?: string;
  class?: string;
  style?: string;
}

const {
  src,
  alt = '',
  variant = 'ink',
  shape = 'plain',
  pos,
  opacity,
  size,
  width = 1200,
  quality = 60,
  eager = false,
  credit,
  class: className = '',
  style = '',
} = Astro.props;

const vars = [
  pos ? `--pos:${pos}` : '',
  opacity !== undefined ? `--opacity:${opacity}` : '',
  size ? `--size:${size}px` : '',
  style,
]
  .filter(Boolean)
  .join(';');
---

<figure class={`engraving engraving--${variant} engraving--${shape} ${className}`.trim()} style={vars || undefined} aria-hidden={alt ? undefined : 'true'}>
  <Image src={src} alt={alt} width={width} format="webp" quality={quality} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  {credit && <figcaption class="engraving__credit">{credit}</figcaption>}
</figure>
