---
import Icon from './Icon.astro';
import { longDay } from '../lib/dates';
import { SITE } from '../config/site';

const steps = [
  { icon: 'stake', title: 'Stake your claim', text: 'Fill in the form below. Two minutes.' },
  { icon: 'shovel', title: 'Get your gear', text: 'Make a free Kaggle account and join the Quant Rush competition page.' },
  { icon: 'cart', title: 'Dig', text: 'Download the data, train models, submit predictions. Come Tuesdays for workshops and office hours.' },
  { icon: 'scales', title: 'The Assay', text: `${longDay(SITE.dates.deadline)}: submissions close. The private leaderboard shows who struck real gold.` },
];
---

<ol class="steps reveal">
  {steps.map((s, i) => (
    <li class="step">
      <div class="step__num">{String(i + 1).padStart(2, '0')}</div>
      <div>
        <h3><Icon name={s.icon} />{s.title}</h3>
        <p>{s.text}</p>
      </div>
    </li>
  ))}
</ol>
